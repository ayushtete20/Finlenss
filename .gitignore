# ========================================
# Node / General Dependencies
# ========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ========================================
# Environment Variables (CRITICAL)
# ========================================
# Never commit your Supabase keys!
.env
.env.*
!.env.example

# ========================================
# Frontend & Portfolio (Vite / React)
# ========================================
# Ignore build outputs generated by Vite
frontend-main/dist/
frontend-main/dist-ssr/
frontend-portfolio/dist/
frontend-portfolio/dist-ssr/
dist/

# Ignore local Vite environment files
frontend-main/*.local
frontend-portfolio/*.local
*.local

# ========================================
# Backend (Express / Node)
# ========================================
# Ignore uploaded user files & attachments
backend/uploads/

# Ignore coverage reports or temporary backend files
backend/coverage/
backend/temp/
backend/.nyc_output/

# Ignore local SQLite database files
backend/*.sqlite
backend/*.sqlite-journal
*.sqlite

# ========================================
# Editor / OS Files & Personal Artifacts
# ========================================
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Installers & Executables
*.msi
*.exe
*.dmg
*.pkg

# Personal documents, PDFs, & Raw screenshots in root
*.pdf
Screenshot*.png
*.png.bak
*.jpeg
*.jpg
!frontend-main/public/**/*
!frontend-portfolio/public/**/*
!frontend-main/src/**/*
!frontend-portfolio/src/**/*

# Temporary data files & notes
*tabase.txt
*.txt.bak
url.txt
*.csv
!backend/csv_exports/*.csv
*.xlsx
!frontend-main/public/*.xlsx
!frontend-portfolio/public/*.xlsx

# Scratch audits & notes
Portfolio Production Readiness Audit.md
